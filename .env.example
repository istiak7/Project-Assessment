# Copy to .env to override docker-compose defaults: `cp .env.example .env`
# All values are optional — docker-compose.yml provides defaults for each.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=istiakahmed
POSTGRES_DB=schooladmission_db

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Production
HOLD_DURATION_SECONDS=300

# --- Host port mappings ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
