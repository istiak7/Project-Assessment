<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>School_Admission_System_Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\Classes\Shared\" />
    <Folder Include="Features\Holds\Shared\" />
  </ItemGroup>

  <!-- The test project lives in a subfolder of this project; keep its sources
       out of the web project's default compilation glob. -->
  <ItemGroup>
    <Compile Remove="SchoolAdmission.Tests\**" />
    <Content Remove="SchoolAdmission.Tests\**" />
    <None Remove="SchoolAdmission.Tests\**" />
    <EmbeddedResource Remove="SchoolAdmission.Tests\**" />
  </ItemGroup>

</Project>
